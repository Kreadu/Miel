# Copiar a .env.local (gitignored) y completar.
# Local: valores que imprime `supabase start`. Cloud: Settings → API del proyecto.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SOLO para scripts administrativos fuera de src/ (seeds, mantenimiento).
# JAMAS importar en codigo de la app (regla 3 de AGENTS.md).
# SUPABASE_SERVICE_ROLE_KEY=

# Envío de correo de invitación (S12-03). Sin key: createInvitation no envía el correo,
# pero el enlace copiable sigue funcionando igual (fallback, no bloquea el flujo).
# RESEND_API_KEY=

# S21-03 (ADR-037): firma de la cookie del modo tienda. Genérala con: openssl rand -base64 48
MIEL_SESSION_SECRET=

# S22-03 (ADR-039): asesor con IA en Resultados (Anthropic). Solo servidor. Sin key: la sección
# muestra "La IA no está configurada" y el resto de la página funciona igual.
# ANTHROPIC_API_KEY=
